# Copy to .env for local dev. Vite inlines only VITE_* at build time.
# Missing VITE_APP_API_URL throws (fail-fast) unless the mock rail is on.
# Never set VITE_USE_MOCKS outside local. Staging/prod ignore it.

VITE_APP_API_URL=http://localhost:5015/api/v1
VITE_APP_URL=http://localhost:5401
VITE_ENVIRONMENT=local
VITE_APP_ENVIRONMENT=dev

# Continue allowlist (P022). Fail closed in production-like env when missing.
VITE_LEARN_URL=http://localhost:5402
VITE_WEBSITE_URL=http://localhost:3020
VITE_ADMIN_URL=http://localhost:5403

# Optional
# VITE_THEME_COOKIE_DOMAIN=
# VITE_DEPLOYMENT_REGION=
# VITE_APP_PUBLIC_POSTHOG_KEY=
# VITE_APP_PUBLIC_POSTHOG_HOST=
# VITE_APP_PUBLIC_SENTRY_DSN=

# Recommended mock rail only (idea.md §22.10). Leave unset to hit the real API.
# Requires VITE_ENVIRONMENT=local. Staging/prod ignore this flag.
# VITE_APP_API_URL may be omitted while mocks are on.
# VITE_USE_MOCKS=true
